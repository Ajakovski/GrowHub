# Copy to .env (next to compose.yaml) and fill in. .env is git-ignored.

# Shared secrets between services. Change these for anything beyond local testing.
GROWHUB_DEVICE_KEY=dev-device-key
GROWHUB_AI_KEY=dev-ai-key

# LLM provider (OpenAI-compatible). OpenRouter by default.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# OpenAI instead:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Gemini instead:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash

# Minutes between automatic AI reviews of each hub (0 disables it).
REVIEW_INTERVAL_MINUTES=30

# Websites allowed to log in to the dashboard. Empty = localhost and home-network IPs.
# For a real domain, e.g.: GROWHUB_WEB_ORIGIN_REGEX=https://growhub\.example\.com
GROWHUB_WEB_ORIGIN_REGEX=
# Set to 1 when the site is served over HTTPS so the login cookie is only sent encrypted.
GROWHUB_COOKIE_SECURE=0

# Verification emails via Resend (https://resend.com/api-keys). Empty = links are printed in the backend log.
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
GROWHUB_EMAIL_FROM=GrowHub <onboarding@resend.dev>
# Where verification links point. Empty = whatever site the user signed up from.
GROWHUB_PUBLIC_URL=
